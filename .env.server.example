# SERVER-ONLY. Never prefix these with VITE_. Never commit .env.server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Configurable examples from official model catalog consulted 2026-10-04.
OPENAI_MODEL=gpt-6.1-sol
OPENAI_EXTRACTION_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
ALLOWED_ORIGIN=http://localhost:5173
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# Number that receives messages, in international format with digits only (no +).
WHATSAPP_BUSINESS_PHONE=
# Set a supported Graph API version from your Meta app dashboard.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_FINANCIAL_TEMPLATE=
# Account ID from Meta; different from WHATSAPP_PHONE_NUMBER_ID.
WHATSAPP_BUSINESS_ACCOUNT_ID=
FINANCIAL_JOB_SECRET=
OPENAI_VISION_MODEL=gpt-4o-mini
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
